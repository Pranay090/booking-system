# JWT Configuration
JWT_SECRET='supersecretkey'

# Google OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:4200

# Database Configuration
# Option 1: Connection string (for Neon / cloud Postgres)
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Option 2: Individual params (for local / Docker)
DB_USER=admin
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking

# Redis Configuration
# Option 1: Full URL (for Upstash / cloud Redis)
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
# Option 2: Host only (for local / Docker)
REDIS_HOST=localhost

# Run pricing worker inside the API process (set true for single-service deploys)
ENABLE_WORKER=false

# Node Environment
NODE_ENV=development
